        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xsmall|small|medium|large)$/]",
        "message": "<Chip> size must be one of 'xsmall' | 'small' | 'medium' | 'large'."
